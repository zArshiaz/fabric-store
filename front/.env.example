# Browser (CSR) — also used as SSR fallback when API_BASE_URL is unset
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Server-side (SSR) inside Docker Compose — reach backend by service name
# Local (no Docker): use the same host URL as NEXT_PUBLIC_API_BASE_URL
API_BASE_URL=http://localhost:4000/api
